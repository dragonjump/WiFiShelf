{
  "name": "WifiShelf",
  "version": "1.0.0",
  "description": "A lightweight remote file viewer and manager built in Node.js",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": " npx kill-port 3006   && node server.js",
    "clean-exe": "if exist dist\\WifiShelf.exe del /f /q dist\\WifiShelf.exe",
    "make-icon": "node make-icon.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/WifiShelf.exe",
    "icon:exe": "node set-icon.js",
    "build:exe:full": "npx kill-port 3006   && npm run clean-exe && npm run make-icon && npm run build:exe  "
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "config.json"
    ]
  },
  "dependencies": {
    "express": "^4.19.2",
    "mime-types": "^2.1.35",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "pkg": "^5.8.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^2.2.0"
  },
  "author": "Antigravity",
  "license": "ISC",
  "build": {
    "appId": "com.dragonjump.wifishelf",
    "productName": "WifiShelf",
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "public/**/*",
      "electron-main.js",
      "package.json"
    ]
  }
}